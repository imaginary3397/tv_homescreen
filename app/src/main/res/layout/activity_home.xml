<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:clipChildren="false">

    <!-- Bakgrundsvideon -->
    <TextureView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Stillbild som visas när ingen rört fjärrkontrollen på en minut -->
    <ImageView
        android:id="@+id/still"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Dämpning uppe och nere så att text och appar syns -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Översta raden: små knappar till vänster, klocka till höger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="30dp"
        android:paddingEnd="60dp">

        <TextView
            android:id="@+id/btn_all_apps"
            style="@style/SmallButton"
            android:text="@string/all_apps" />

        <TextView
            android:id="@+id/btn_settings"
            style="@style/SmallButton"
            android:layout_marginStart="6dp"
            android:text="@string/settings" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_main"
                android:textSize="20sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Appraden längst ner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/focused_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/app_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
